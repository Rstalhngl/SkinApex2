# Copy this file to .env.local and fill in your values

# Your production domain (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://skinapex.net

# Session signing secret (required in production)
SESSION_SECRET=

# PostgreSQL connection (optional — without it, JSON files in data/ are used)
# Example: postgres://skinapex:password@localhost:5432/skinapex
DATABASE_URL=

# Steam Web API key (optional — enables profile name + avatar on login)
# Get yours at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Admin panel access — comma-separated Steam IDs (64-bit)
# Example: ADMIN_STEAM_IDS=76561198012345678,76561198987654321
ADMIN_STEAM_IDS=
