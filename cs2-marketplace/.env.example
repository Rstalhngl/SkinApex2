# Copy this file to .env.local and fill in your values

# Your production domain (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://skinapex.net

# Session signing secret (required in production)
SESSION_SECRET=

# Allowed origins for Steam login redirect (comma-separated)
# Example: ALLOWED_AUTH_ORIGINS=https://skinapex.net,http://localhost:3000
ALLOWED_AUTH_ORIGINS=

# Demo wallet deposits without payment gateway (default: off in production)
ALLOW_DEMO_DEPOSITS=false

# Cron secret for expire-sales job (can reuse WS_API_KEY)
CRON_SECRET=

# PostgreSQL connection (optional — without it, JSON files in data/ are used)
# Example: postgres://skinapex:password@localhost:5432/skinapex
DATABASE_URL=

# Steam Web API key (optional — enables profile name + avatar on login)
# Get yours at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Admin panel access — comma-separated Steam IDs (64-bit)
# Example: ADMIN_STEAM_IDS=76561198012345678,76561198987654321
ADMIN_STEAM_IDS=

# Steam trade bot (optional — auto send/receive trade offers)
TRADE_BOT_ENABLED=false
TRADE_BOT_API_KEY=
TRADE_BOT_APP_URL=http://127.0.0.1:3000
TRADE_BOT_POLL_MS=15000
TRADE_BOT_AUTO_ACCEPT_DEPOSITS=false
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
STEAM_BOT_SHARED_SECRET=
STEAM_BOT_IDENTITY_SECRET=

# WebSocket live sync (optional — replaces 10s polling with instant updates)
WS_PORT=3001
WS_API_KEY=
WS_INTERNAL_HOST=127.0.0.1
# Browser connects here (production: wss://skinapex.net/ws via nginx proxy)
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_WS_PORT=3001
